# Токен бота от @BotFather (не коммитить значение в открытый репозиторий)

BOT_TOKEN=



# PostgreSQL + pgvector (RAG). Локально: postgresql://postgres:PASSWORD@localhost:5432/telebotik
# На VPS: postgresql://USER:TelebotikDB2026@localhost:5432/telebotik

DATABASE_URL=



# Необязательно — если `npm start` не достукивает Telegram (ETIMEDOUT):

# TELEGRAM_PROXY=http://127.0.0.1:7890
# SOCKS_PROXY=socks5://127.0.0.1:10808



# --- GigaChat API (чат + embeddings — один Authorization Key)

GIGACHAT_AUTHORIZATION_KEY=

GIGACHAT_SCOPE=GIGACHAT_API_PERS

# GIGACHAT_MODEL=GigaChat

# Embeddings для RAG — см. https://developers.sber.ru/docs/ru/gigachat/guides/embeddings

# GIGACHAT_EMBEDDINGS_MODEL=Embeddings

# GIGACHAT_TLS_INSECURE=1

# GIGACHAT_VERIFY_SSL_CERTS=false



# --- RAG (поиск по docs/)

# Сколько фрагментов подставлять в промпт

# RAG_TOP_K=4

# Минимальная cosine-similarity (0..1). Ниже — fallback «нет в документах»

# RAG_MIN_SIMILARITY=0.32
