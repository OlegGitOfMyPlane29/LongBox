# Токен бота от @BotFather (не коммитить значение в открытый репозиторий)

BOT_TOKEN=



# Необязательно — если `npm start` не достукивает Telegram (ETIMEDOUT),
# но браузер с VPN открывает сайты: укажите локальный порт из приложения VPN / Clash / v2rayN.
#
# TELEGRAM_PROXY=http://127.0.0.1:7890          # типичный HTTP(S) локальный прокси
# SOCKS_PROXY=socks5://127.0.0.1:10808        # альтернатива SOCKS5
#
# То же действует переменная HTTPS_PROXY (глобально для процесса), если хотите её переиспользовать.



# --- GigaChat API (нейросеть). Ключ создан в кабинете developers.sber.ru:
# строка авторизации для схемы Basic (обычно base64 от ClientID:Secret), по доке без префикса `Basic `
GIGACHAT_AUTHORIZATION_KEY=

# Часто нужно именно это значение проекта для физлиц:
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель (по умолчанию GigaChat — Lite на Freemium, см. комментарий в src/gigachatClient.js)
# GIGACHAT_MODEL=GigaChat

# Если без корневого сертификата НУЦ Минцифры HTTPS к Сберу из Node даёт ошибку цепочки:
# вариант A (быстро для ДЗ на своей машине):
# GIGACHAT_TLS_INSECURE=1
# вариант B как в официальном Python SDK gigachat:
# GIGACHAT_VERIFY_SSL_CERTS=false
