# ---------------------------------------------------------------------------
# Локальная разработка: скопируйте в .env (файл .env в git не коммитится — см. .gitignore).
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# Локально — строка подключения к Postgres или оставьте пустым для SQLite по умолчанию (только dev).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/challenge100days

# Development: сгенерируйте свой ключ или оставьте плейсхолдер — в dev будет подставлен запасной ключ из кода.
# НИКОГДА не используйте плейсхолдер в production.
SECRET_KEY=replace_with_long_secret_key

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Только доверенные origin фронтенда (через запятую, без пробелов вокруг или с trim на сервере).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Лимит slowapi для POST /auth/login и /auth/register (по умолчанию: 10 за 15 минут).
# Формат: "10 per 15 minutes" или см. документацию пакета limits / slowapi.
AUTH_RATE_LIMIT=

ADMIN_EMAIL=admin@challenge100days.local
ADMIN_PASSWORD=admin12345
ADMIN_DISPLAY_NAME=Администратор

QUOTES_API_KEY=
QUOTES_TIMEOUT_SECONDS=8
QUOTES_PRIMARY_URL=https://api.quotable.io/quotes/random
QUOTES_SECONDARY_URL=https://zenquotes.io/api/random

# ---------------------------------------------------------------------------
# ПРОДАКШЕН (обязательный чеклист — значения только из окружения сервера, не из git):
#
#   APP_ENV=production
#
#   DATABASE_URL — рабочая строка к Postgres (или иной БД), обязательна; без неё процесс не поднимется.
#
#   SECRET_KEY — случайная строка >= 32 символов; не используйте replace_with_long_secret_key, change_me,
#   admin12345 и т.п. Генерация: openssl rand -base64 32
#
#   CORS_ORIGINS — только реальные HTTPS-ординары вашего фронта.
#
#   Запуск: uvicorn без --reload; не включайте debug у приложения.
#
#   ADMIN_* задайте надёжным паролем при первом seed; не оставляйте пример из этого файла.
# ---------------------------------------------------------------------------

# Frontend
VITE_API_URL=http://127.0.0.1:8000
