# Скопируйте этот файл в .env на VPS (рядом с docker-compose.yml) и замените плейсхолдеры.
# Никогда не коммитьте .env с секретами.

APP_ENV=production

# openssl rand -base64 48
SECRET_KEY=минимум_32_случайных_символа_не_оставлять_этот_текст

# То же самое пользовательское имя/пароль увидят и Postgres, и FastAPI (через compose).
DB_USER=challenge_app
DB_PASSWORD=придумайте_сложный_пароль
DB_NAME=challenge100days

# Origin браузера: ровно тот адрес, с которого открываете сайт (схема + хост [, порт]).
# Примеры: https://example.ru  или  http://123.45.67.89:8080
# Несколько значений через запятую без пробелов.
# Пример с доменом и HTTPS: https://days100.ru,https://www.days100.ru
CORS_ORIGINS=https://ваш-домен-или-ip

# Админ для seed (после миграций: docker compose run --rm api python seed_admin.py).
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=смените_пароль
ADMIN_DISPLAY_NAME=Администратор

# Сборка фронта: относительный путь /api — тот же префикс, что в deploy/nginx/default.conf.
# Меняйте только если меняете маршрутизацию в nginx.
VITE_API_URL=/api

# Порт на хосте VPS, куда nginx отдаёт HTTP (80 по умолчанию). Для проверки на нестандартном порту: 8080
HTTP_PUBLISH_PORT=80
