# Backend
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# PostgreSQL (optional). If empty, SQLite is used: sqlite:///./challenge20days.db
DATABASE_URL=
# Comma-separated origins (no spaces). Required for CORS — never use * in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
